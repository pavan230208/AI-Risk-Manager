# Environment
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/risk_manager

# Redis and Idempotency
REDIS_URL=redis://localhost:6379/0
EVENT_BUS_BACKEND=redis
ACTION_LEASE_SECONDS=10
ACTION_MAX_LEASE_SECONDS=60
ACTION_IDEMPOTENCY_TTL_SECONDS=604800

# Security
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY=CHANGE_ME_TO_A_SECURE_API_KEY
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-production-domain.com"]

# Request Size Limit
MAX_REQUEST_SIZE_BYTES=1048576

# LLM Configuration
LLM_PROVIDER=gemini # Example: openai, gemini, ollama
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=CHANGE_ME_TO_A_VALID_API_KEY
